{
  "name": "3d-print-letterpress",
  "version": "0.0.4",
  "author": "Jonathan Zong <jonathan@jonathanzong.com>",
  "description": "OpenType and TrueType to 3D-printable .stl of type for letterpress printing",
  "contributors": [
    {
      "name": "Jonathan Zong",
      "email": "jonathan@jonathanzong.com"
    }
  ],
  "scripts": {
    "start": "node ./index.js",
    "test": "node --test tests/*.test.js"
  },
  "bin": "./index.js",
  "global": "true",
  "repository": {
    "type": "git",
    "url": ""
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "opentype.js": "^1.3.4",
    "svg-path-parser": "^1.1.0",
    "svg-path-properties": "^2.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "c8": {
    "include": [
      "index.js",
      "src/**/*.js"
    ],
    "exclude": [
      "lib/**",
      "tests/**",
      "coverage/**",
      "tmp/**"
    ]
  }
}